{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh ruleset list:*)",
      "Bash(gh ruleset view:*)",
      "Bash(gh ruleset check:*)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh api:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh ruleset update:*)",
      "Bash(gh ruleset delete:*)"
    ]
  }
}
